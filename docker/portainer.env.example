# Variables à saisir dans Portainer → Stacks → ged → Environment variables
# (ou « Load variables from .env file » avec une copie remplie de ce fichier, JAMAIS commitée).
# Les autres réglages (APP_ENV, DB_HOST=mysql, sessions, file d'attente…) sont fixés dans docker-compose.yml.

# ── Obligatoires ─────────────────────────────────────────────
# Générer en local : php artisan key:generate --show
APP_KEY=base64:CHANGER_MOI
APP_URL=https://ged.imperis.com
SESSION_DOMAIN=ged.imperis.com

# Base dédiée sur le MySQL partagé (voir docker/mysql-init.sql)
DB_DATABASE=ged_db
DB_USERNAME=ged_user
DB_PASSWORD=CHANGER_MOI

# MinIO (bucket privé)
AWS_ACCESS_KEY_ID=CHANGER_MOI
AWS_SECRET_ACCESS_KEY=CHANGER_MOI
AWS_URL=https://api.storage.imperis.com
AWS_ENDPOINT=https://api.storage.imperis.com

# ── Facultatives (valeur par défaut entre parenthèses) ──────
# IMAGE_TAG=latest                 (tag des images imperissoft/ged et ged-nginx)
# HOST_PORT=8003                   (port hôte de nginx — 8002 est pris par Notaris)
# APP_NAME=GED
# LOG_LEVEL=error
# AWS_BUCKET=ged
# AWS_DEFAULT_REGION=us-east-1
# AWS_USE_PATH_STYLE_ENDPOINT=true
# SAAS_SUPER_ADMIN_EMAIL=contact@imperis.com

# E-mails (les paramètres SMTP peuvent aussi être saisis dans l'application)
# MAIL_MAILER=smtp
# MAIL_SCHEME=
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=infos@ged.imperis.com
# MAIL_FROM_NAME=GED
